{
  "name": "talk-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Talk chat server - Express 5, MongoDB, Socket.IO",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "migrate:legacy": "node scripts/migrate-legacy.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "crypto-js": "^4.2.0",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4"
  }
}
